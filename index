<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Informasi Statistik - Kabupaten Sleman</title>
    <style>
        :root {
            --primary-navy: #0F2C59;
            --accent-orange: #FF6B35;
            --light-orange: #FFF0EB;
            --bg-white: #FFFFFF;
            --text-dark: #1E293B;
            --border-color: #CBD5E1;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: var(--bg-white);
            color: var(--text-dark);
        }

        .container {
            max-width: 1050px;
            margin: 0 auto;
            border: 2px solid var(--primary-navy);
            border-radius: 12px;
            padding: 15px;
            box-shadow: 0 4px 12px rgba(15, 44, 89, 0.1);
        }

        /* Header Style */
        .header {
            border: 2px solid var(--primary-navy);
            border-radius: 8px;
            padding: 15px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, var(--primary-navy) 0%, #1A365D 100%);
            color: var(--bg-white);
        }

        .header .logo {
            width: 85px;
            height: 85px;
            border: 2px solid var(--accent-orange);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--bg-white);
            overflow: hidden;
            padding: 4px;
        }

        .header .logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .header-title {
            flex-grow: 1;
            text-align: center;
        }

        .header-title h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #FFFFFF;
        }

        .header-title h2 {
            margin: 6px 0 0 0;
            font-size: 20px;
            font-weight: 500;
            color: var(--accent-orange);
        }

        /* Main Content Layout */
        .main-content {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .left-panel {
            width: 35%;
            border: 2px solid var(--primary-navy);
            border-radius: 8px;
            padding: 18px;
            background-color: var(--bg-white);
        }

        .left-panel h3 {
            margin-top: 0;
            font-size: 18px;
            text-align: center;
            color: var(--primary-navy);
            border-bottom: 3px solid var(--accent-orange);
            padding-bottom: 10px;
        }

        .left-panel p {
            font-size: 13.5px;
            line-height: 1.6;
            text-align: justify;
            color: var(--text-dark);
        }

        .right-panel {
            width: 65%;
        }

        /* Table Style */
        .table-title {
            background-color: var(--primary-navy);
            color: var(--bg-white);
            border: 2px solid var(--primary-navy);
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            text-align: center;
            font-weight: bold;
            padding: 10px;
            font-size: 15px;
            letter-spacing: 0.5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            border: 2px solid var(--primary-navy);
            border-radius: 0 0 8px 8px;
            overflow: hidden;
            background-color: var(--bg-white);
        }

        th, td {
            border: 1px solid var(--border-color);
            padding: 9px 12px;
            font-size: 13px;
            text-align: center;
        }

        th {
            background-color: var(--accent-orange);
            color: var(--bg-white);
            font-weight: 600;
            border-color: #E25822;
        }

        tbody tr:nth-child(even) {
            background-color: var(--light-orange);
        }

        tbody tr:hover {
            background-color: #FFE3D8;
            transition: background-color 0.2s ease;
        }

        td:first-child {
            text-align: left;
            font-weight: 600;
            color: var(--primary-navy);
        }

        /* Footer Style */
        .footer {
            border: 2px solid var(--primary-navy);
            border-radius: 8px;
            padding: 18px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: var(--bg-white);
            border-top: 4px solid var(--accent-orange);
        }

        .footer-logo {
            width: 70px;
            height: 70px;
            border: 2px solid var(--primary-navy);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            background-color: var(--light-orange);
            overflow: hidden;
            padding: 4px;
        }

        .footer-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .footer h4 {
            margin: 0 0 6px 0;
            font-size: 17px;
            color: var(--primary-navy);
        }

        .footer p {
            margin: 3px 0;
            font-size: 12.5px;
            color: var(--text-dark);
        }

        .footer p span {
            color: var(--accent-orange);
            font-weight: 600;
        }
    </style>
</head>
